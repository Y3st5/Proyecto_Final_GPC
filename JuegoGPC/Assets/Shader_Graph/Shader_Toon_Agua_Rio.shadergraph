{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "2a886be2b54b4edd8f9d230297082e75",
    "m_Group": {
        "m_Id": "6591371ece604f7a94659709fec30d14"
    },
    "m_Name": "OlasRioToon (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 80.0,
            "y": -320.0,
            "width": 260.0,
            "height": 220.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "84fca94a484346dfa91bf14d5c2f4ebe"
        },
        {
            "m_Id": "68183ffd3d1a4410bf8f98a19117e565"
        },
        {
            "m_Id": "e69d71019b8a453398c2783c136cf70c"
        },
        {
            "m_Id": "23f66f3665394c6aa2a008e5a0154d83"
        },
        {
            "m_Id": "8a6ab909f9a74ac097b439487c9de03d"
        },
        {
            "m_Id": "09b6cd4c5c094d39b8c46b877013fa02"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "OlasRioToon",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Dos ondas cruzadas en espacio local (funciona en rio horizontal y cascada inclinada)\nfloat spd = max(abs(FlowSpeed), 0.25) * (FlowSpeed < 0.0 ? -1.0 : 1.0);\nfloat p1 = ObjectPos.z * 1.05 + TimeVal * spd * 1.45;\nfloat p2 = (ObjectPos.x * 0.90 - ObjectPos.z * 0.50) + TimeVal * spd * 1.85;\n\nfloat dispY = (sin(p1) * 0.65 + sin(p2) * 0.35) * WaveHeight;\nOutPos = ObjectPos + float3(0.0, dispY, 0.0);\n\n// Normal analitica exacta en espacio objeto para reflejos Toon en las olas\nfloat dYdx = cos(p2) * 0.90 * 0.35 * WaveHeight;\nfloat dYdz = (cos(p1) * 1.05 * 0.65 - cos(p2) * 0.50 * 0.35) * WaveHeight;\nOutNormal = normalize(float3(-dYdx, 1.0, -dYdz));"
}

