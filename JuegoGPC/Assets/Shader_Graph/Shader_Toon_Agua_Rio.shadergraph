{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "e694c3f2697d4b45a982df54c27d233d",
    "m_Group": {
        "m_Id": "92897ebe35be4e9eb31a23cb672d9c98"
    },
    "m_Name": "AguaToonDetallada (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 80.0,
            "y": 140.0,
            "width": 280.0,
            "height": 430.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "b77e0b61670b456d815e72589d5808d3"
        },
        {
            "m_Id": "aaba11620553495a81cf0b340ede5361"
        },
        {
            "m_Id": "7fe1bbb9656a48739ce2fcf03f2863cc"
        },
        {
            "m_Id": "0b8081b313654130b690561d11821586"
        },
        {
            "m_Id": "e9eeaafe97bc4469b09dc76dbbefa87f"
        },
        {
            "m_Id": "21221d7c98444459af45c1e1bc388fd1"
        },
        {
            "m_Id": "f7820439c5814bf3994bb49d85aacea2"
        },
        {
            "m_Id": "89394ad97d8149e7ab2ed250d91f575e"
        },
        {
            "m_Id": "d12fe08f11344d738599d453ee6cf4e0"
        },
        {
            "m_Id": "b1f3503c26094647b98f4f4aafb3eade"
        },
        {
            "m_Id": "dee273775796423ba2c5b88f63c0dd8c"
        },
        {
            "m_Id": "b28980d6ec0d4100b7f444fdbbf0cd2c"
        },
        {
            "m_Id": "e5a62d297d004a8ea2b80da07732c77c"
        },
        {
            "m_Id": "feb7a03ee0d1488b96b73173e169a4cf"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "AguaToonDetallada",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 uv = UVIn.xy;\nfloat scl = max(0.15, WaterScale);\n\n// Coordenada isotropica en metros (sin estiramientos en rio, poza ni cascada)\nfloat flowAxis = WorldPos.z + WorldPos.y;\nfloat2 p = float2(WorldPos.x, flowAxis) * scl;\nfloat scroll = TimeVal * FlowSpeed * scl;\n\n// Deformacion liquida organica\nfloat2 warp = float2(\n    sin(p.y * 1.40 + scroll * 1.80) * 0.16,\n    cos(p.x * 1.80 + scroll * 1.20) * 0.12\n);\n\n// --- 1. Causticas Toon (doble capa Voronoi con paralaje) ---\nfloat2 vUV1 = p + warp + float2(0.0, scroll);\nfloat2 g1 = floor(vUV1);\nfloat2 f1 = frac(vUV1);\nfloat minD1 = 8.0;\nfloat secD1 = 8.0;\nfor (int y1 = -1; y1 <= 1; y1++)\n{\n    for (int x1 = -1; x1 <= 1; x1++)\n    {\n        float2 cell = g1 + float2((float)x1, (float)y1);\n        float2 rnd = frac(sin(float2(dot(cell, float2(127.1, 311.7)), dot(cell, float2(269.5, 183.3)))) * 43758.5453);\n        float2 pt = float2((float)x1, (float)y1) + 0.5 + 0.36 * sin(TimeVal * 1.35 + 6.2831 * rnd) - f1;\n        float d = length(pt);\n        if (d < minD1) { secD1 = minD1; minD1 = d; }\n        else if (d < secD1) { secD1 = d; }\n    }\n}\nfloat edge1 = secD1 - minD1;\n\nfloat2 vUV2 = p * 1.48 - warp * 0.60 + float2(0.41, scroll * 0.65);\nfloat2 g2 = floor(vUV2);\nfloat2 f2 = frac(vUV2);\nfloat minD2 = 8.0;\nfloat secD2 = 8.0;\nfor (int y2 = -1; y2 <= 1; y2++)\n{\n    for (int x2 = -1; x2 <= 1; x2++)\n    {\n        float2 cell = g2 + float2((float)x2, (float)y2);\n        float2 rnd = frac(sin(float2(dot(cell, float2(127.1, 311.7)), dot(cell, float2(269.5, 183.3)))) * 43758.5453);\n        float2 pt = float2((float)x2, (float)y2) + 0.5 + 0.36 * sin(TimeVal * 1.05 + 6.2831 * rnd) - f2;\n        float d = length(pt);\n        if (d < minD2) { secD2 = minD2; minD2 = d; }\n        else if (d < secD2) { secD2 = d; }\n    }\n}\nfloat edge2 = secD2 - minD2;\n\nfloat web1 = 1.0 - smoothstep(0.072, 0.102, edge1);\nfloat web2 = (1.0 - smoothstep(0.045, 0.072, edge2)) * 0.45;\nfloat rippleMask = saturate(max(web1, web2));\n\n// --- 2. Espuma Toon en orillas (UV.x) + cinta interior + cruces de corriente ---\nfloat bankDist = min(uv.x, 1.0 - uv.x);\nfloat bankWave = sin(p.y * 2.2 + scroll * 2.4) * 0.018\n               + sin(p.y * 4.7 - scroll * 1.6) * 0.008;\nfloat edgeDist = bankDist + bankWave;\n\nfloat shoreMain = 1.0 - smoothstep(max(0.001, ShoreFoam - 0.012), max(0.013, ShoreFoam), edgeDist);\nfloat ribbonWave = sin(p.y * 3.1 + scroll * 2.7) * 0.5 + 0.5;\nfloat shoreRibbon = (1.0 - smoothstep(0.009, 0.017, abs(edgeDist - (ShoreFoam + 0.038)))) * smoothstep(0.38, 0.48, ribbonWave);\nfloat crestFoam = 1.0 - smoothstep(0.055, 0.085, edge1 + edge2);\nfloat foamMask = saturate(max(max(shoreMain, shoreRibbon), crestFoam));\n\n// --- 3. Bandas Toon de profundidad (orilla turquesa -> centro profundo) ---\nfloat dRaw = smoothstep(ShoreFoam, ShoreFoam + 0.25, edgeDist);\nfloat band1 = smoothstep(0.24, 0.29, dRaw);\nfloat band2 = smoothstep(0.64, 0.69, dRaw);\nfloat depthBand = (band1 + band2) * 0.5;\n\nfloat3 waterAlbedo = lerp(ShallowColor, DeepColor, depthBand);\nfloat3 rippleCol = lerp(ShallowColor, FoamColor, 0.58);\nwaterAlbedo = lerp(waterAlbedo, rippleCol, rippleMask * 0.72);\nwaterAlbedo = lerp(waterAlbedo, FoamColor, foamMask);\n\n// --- 4. Iluminacion Dia / Noche real (Sol, Luna, Ambiente, Sombra del puente y Faroles) ---\nfloat3 N = normalize(WorldNormal);\nfloat3 V = normalize(WorldView);\n\nfloat3 lightDir = normalize(float3(0.42, 0.85, 0.32));\nfloat3 lightCol = float3(1.0, 1.0, 1.0);\nfloat3 ambCol = float3(0.55, 0.62, 0.72);\nfloat shadowAtten = 1.0;\n\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED)\n    float4 clipPos = TransformWorldToHClip(WorldPos);\n    #if defined(_MAIN_LIGHT_SHADOWS_SCREEN)\n        float4 shadowCoord = ComputeScreenPos(clipPos);\n    #else\n        float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\n    #endif\n    Light mainLight = GetMainLight(shadowCoord);\n    lightDir = mainLight.direction;\n    lightCol = mainLight.color;\n    shadowAtten = mainLight.distanceAttenuation * mainLight.shadowAttenuation;\n    ambCol = SampleSH(N);\n#endif\n\nfloat softShadow = lerp(0.58, 1.0, shadowAtten);\nfloat3 envLight = min(float3(1.15, 1.15, 1.15), ambCol * 0.50 + lightCol * (0.65 * softShadow));\nfloat3 litWater = waterAlbedo * envLight;\n\n// Destello Toon del Sol o la Luna sobre las olas + Fresnel atmosferico\nfloat3 H = normalize(lightDir + V);\nfloat spec = smoothstep(0.925, 0.948, saturate(dot(N, H))) * shadowAtten;\nfloat fresnel = smoothstep(0.58, 0.66, pow(1.0 - saturate(dot(N, V)), 3.2));\nfloat3 skyGlint = lightCol * (spec * 0.65) + (ambCol * 0.30 + lightCol * 0.15) * fresnel;\n\n// Reflejos calidos Toon de los faroles de noche (compatible con Forward y Forward+ en Unity 6)\nfloat3 extraWaterLight = float3(0.0, 0.0, 0.0);\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED) && defined(_ADDITIONAL_LIGHTS)\n    InputData inputData = (InputData)0;\n    inputData.positionWS = WorldPos;\n    float4 scrPos = ComputeScreenPos(clipPos);\n    inputData.normalizedScreenSpaceUV = scrPos.xy / max(0.0001, scrPos.w);\n    uint pixelLightCount = GetAdditionalLightsCount();\n    LIGHT_LOOP_BEGIN(pixelLightCount)\n        Light addL = GetAdditionalLight(lightIndex, WorldPos);\n        float atten = addL.distanceAttenuation * addL.shadowAttenuation;\n        float3 addH = normalize(addL.direction + V);\n        float addSpec = smoothstep(0.84, 0.90, saturate(dot(N, addH)));\n        float addPool = smoothstep(0.08, 0.22, atten);\n        extraWaterLight += waterAlbedo * addL.color * (atten * 0.55)\n                         + addL.color * ((addSpec * 0.65 + addPool * rippleMask * 0.25) * atten);\n    LIGHT_LOOP_END\n#endif\n\nOutColor = saturate(litWater + skyGlint + extraWaterLight);\nOutAlpha = saturate(lerp(WaterOpacity, 1.0, max(foamMask, rippleMask * 0.35)));"
}

