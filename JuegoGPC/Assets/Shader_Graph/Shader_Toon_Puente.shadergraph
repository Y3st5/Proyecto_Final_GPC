{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c8f16e3deb72459ebae66d9d63184192",
    "m_Group": {
        "m_Id": "c6548c53e346435ab90b0988bc1fcdd2"
    },
    "m_Name": "ToonPuente (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 80.0,
            "y": 160.0,
            "width": 265.0,
            "height": 340.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "d3923519323d44808abdbe793dac29d1"
        },
        {
            "m_Id": "0e881e91965b4a2faebceca5d14642df"
        },
        {
            "m_Id": "67bf7bb37d324e5d884f8e033154604a"
        },
        {
            "m_Id": "30b75b36dd174bd386c453ae68bdcbc8"
        },
        {
            "m_Id": "9ea63deebe114e9289d2c07bf3271e0e"
        },
        {
            "m_Id": "9639932cacc342d88db88a936dc84e88"
        },
        {
            "m_Id": "008d8605d4fa4747aa301395ea345b79"
        },
        {
            "m_Id": "89b9bfa3a868441c9087af4172a90377"
        },
        {
            "m_Id": "7753bcfba3c74d24b8ca72126a76dcd2"
        },
        {
            "m_Id": "b40ae141970a4f3eb1a2414225dea49c"
        },
        {
            "m_Id": "cfc0a06d94b048aabd1f523243288c5f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ToonPuente",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 N = normalize(WorldNormal);\nfloat3 V = normalize(WorldView);\n\n// 1. Veta suave de tablones/piedra en espacio mundo (funciona igual en madera clara, oscura o piedra)\nfloat scl = max(0.3, WoodScale * 0.45);\nfloat3 wp = float3(WorldPos.x * scl * 0.55, WorldPos.y * scl * 0.35, WorldPos.z * scl);\nfloat3 ip = floor(wp);\nfloat3 fp = frac(wp);\nfp = fp * fp * (3.0 - 2.0 * fp);\n\nfloat n000 = frac(sin(dot(ip + float3(0.0, 0.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n100 = frac(sin(dot(ip + float3(1.0, 0.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n010 = frac(sin(dot(ip + float3(0.0, 1.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n110 = frac(sin(dot(ip + float3(1.0, 1.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n001 = frac(sin(dot(ip + float3(0.0, 0.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n101 = frac(sin(dot(ip + float3(1.0, 0.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n011 = frac(sin(dot(ip + float3(0.0, 1.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n111 = frac(sin(dot(ip + float3(1.0, 1.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\n\nfloat nx00 = lerp(n000, n100, fp.x);\nfloat nx10 = lerp(n010, n110, fp.x);\nfloat nx01 = lerp(n001, n101, fp.x);\nfloat nx11 = lerp(n011, n111, fp.x);\nfloat grain = lerp(lerp(nx00, nx10, fp.y), lerp(nx01, nx11, fp.y), fp.z);\n\nfloat3 partCol = BaseColor * lerp(0.88, 1.08, grain);\n\n// 2. Musgo Toon sutil en superficies superiores (+Y) sobre el rio\nfloat upMask = saturate(N.y + (grain - 0.5) * 0.25);\nfloat mossMask = smoothstep(0.72 - MossAmount * 0.35, 0.86 - MossAmount * 0.25, upMask) * saturate(MossAmount * 1.4);\nfloat3 mossCol = float3(0.24, 0.56, 0.24) * lerp(0.86, 1.08, grain);\npartCol = lerp(partCol, mossCol, mossMask);\n\n// 3. Luz principal (Sol / Luna) + Ambiente real de CicloDiaNoche\nfloat3 lightDir = normalize(float3(0.45, 0.82, 0.35));\nfloat3 lightCol = float3(1.0, 1.0, 1.0);\nfloat3 ambCol = float3(0.55, 0.62, 0.72);\nfloat shadowAtten = 1.0;\n\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED)\n    float4 clipPos = TransformWorldToHClip(WorldPos);\n    #if defined(_MAIN_LIGHT_SHADOWS_SCREEN)\n        float4 shadowCoord = ComputeScreenPos(clipPos);\n    #else\n        float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\n    #endif\n    Light mainLight = GetMainLight(shadowCoord);\n    lightDir = mainLight.direction;\n    lightCol = mainLight.color;\n    shadowAtten = mainLight.distanceAttenuation * mainLight.shadowAttenuation;\n    ambCol = SampleSH(N);\n#endif\n\n// 4. Bandas Toon nitidas para tablas, postes y barandas del puente\nfloat ndotl = dot(N, lightDir) * 0.5 + 0.5;\nfloat litRaw = saturate((ndotl + (grain - 0.5) * 0.08) * lerp(0.30, 1.0, shadowAtten));\n\nfloat bandShadow = smoothstep(ShadowCut - 0.02, ShadowCut + 0.02, litRaw);\nfloat bandBright = smoothstep(ShadowCut + 0.28, ShadowCut + 0.34, litRaw);\nfloat toon = bandShadow * 0.65 + bandBright * 0.35;\n\nfloat3 nightFloor = float3(0.0014, 0.0023, 0.0055);\nfloat3 darkCol = partCol * (ambCol * (ShadowColor * 1.15 + 0.16)) + nightFloor;\nfloat3 mainDirect = partCol * lightCol * (toon * 0.90);\n\n// 5. Luces adicionales Toon (Faroles junto al puente de noche en Forward y Forward+)\nfloat3 extraLights = float3(0.0, 0.0, 0.0);\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED) && defined(_ADDITIONAL_LIGHTS)\n    InputData inputData = (InputData)0;\n    inputData.positionWS = WorldPos;\n    float4 scrPos = ComputeScreenPos(clipPos);\n    inputData.normalizedScreenSpaceUV = scrPos.xy / max(0.0001, scrPos.w);\n    uint pixelLightCount = GetAdditionalLightsCount();\n    LIGHT_LOOP_BEGIN(pixelLightCount)\n        Light addL = GetAdditionalLight(lightIndex, WorldPos);\n        float addNdotL = dot(N, addL.direction) * 0.5 + 0.5;\n        float addToon = smoothstep(0.32, 0.42, saturate(addNdotL + (grain - 0.5) * 0.06));\n        float atten = addL.distanceAttenuation * addL.shadowAttenuation;\n        extraLights += partCol * addL.color * (addToon * atten * 0.85);\n    LIGHT_LOOP_END\n#endif\n\n// 6. Borde luminoso Toon sutil en cantos\nfloat rimDot = 1.0 - saturate(dot(N, V));\nfloat rimMask = smoothstep(0.66, 0.74, pow(rimDot, 3.0)) * bandShadow * RimStrength;\nfloat3 rimFinal = RimColor * lightCol * (rimMask * 0.25);\n\nOutColor = saturate(darkCol + mainDirect + extraLights + rimFinal);"
}

