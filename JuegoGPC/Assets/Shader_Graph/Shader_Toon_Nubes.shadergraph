{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "aebccb0ced7045a8848b4dc5293ace03",
    "m_Group": {
        "m_Id": "b96c829bd30f4d4896274667250d9d9a"
    },
    "m_Name": "ToonNube (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 40.0,
            "y": 280.0,
            "width": 265.0,
            "height": 340.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "559aa54a73324927ac3d3d13894a40dd"
        },
        {
            "m_Id": "21687b988e22401f938458116e9d6d3a"
        },
        {
            "m_Id": "fa5e7fb3d75341f8b20d45b74da64d5c"
        },
        {
            "m_Id": "453192e9885b42a1bea2410c8a53496f"
        },
        {
            "m_Id": "33f36bcfb84748fb8d41f63e58c1f5d3"
        },
        {
            "m_Id": "9f17f1d309b540cabe62f0e26598db97"
        },
        {
            "m_Id": "a309e25b29c348aab317e5d4c5bad0e2"
        },
        {
            "m_Id": "fe0346e42bb8444baf2501222812ec89"
        },
        {
            "m_Id": "77433cfde0d84df087c6c3c1e33601e4"
        },
        {
            "m_Id": "3e0ad4daa7be4eb9b372d7e21d6b1087"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ToonNube",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 N = normalize(WorldNormal);\nfloat3 V = normalize(WorldView);\n\n// 1. Ruido 3D algodonoso en espacio mundo para bordes suaves de nube Toon\nfloat3 wp = WorldPos * max(0.05, FluffScale * 0.14);\nfloat3 ip = floor(wp);\nfloat3 fp = frac(wp);\nfp = fp * fp * (3.0 - 2.0 * fp);\n\nfloat n000 = frac(sin(dot(ip + float3(0.0, 0.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n100 = frac(sin(dot(ip + float3(1.0, 0.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n010 = frac(sin(dot(ip + float3(0.0, 1.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n110 = frac(sin(dot(ip + float3(1.0, 1.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n001 = frac(sin(dot(ip + float3(0.0, 0.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n101 = frac(sin(dot(ip + float3(1.0, 0.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n011 = frac(sin(dot(ip + float3(0.0, 1.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n111 = frac(sin(dot(ip + float3(1.0, 1.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\n\nfloat nx00 = lerp(n000, n100, fp.x);\nfloat nx10 = lerp(n010, n110, fp.x);\nfloat nx01 = lerp(n001, n101, fp.x);\nfloat nx11 = lerp(n011, n111, fp.x);\nfloat fluff = lerp(lerp(nx00, nx10, fp.y), lerp(nx01, nx11, fp.y), fp.z);\n\n// 2. Luz principal (Sol / Atardecer / Luna) + Ambiente real de CicloDiaNoche\nfloat3 lightDir = normalize(float3(0.45, 0.82, 0.35));\nfloat3 lightCol = float3(1.0, 1.0, 1.0);\nfloat3 ambCol = float3(0.65, 0.72, 0.85);\n\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED)\n    Light mainLight = GetMainLight();\n    lightDir = mainLight.direction;\n    lightCol = mainLight.color;\n    ambCol = SampleSH(N);\n#endif\n\n// 3. Bandas Toon algodonosas (parte superior iluminada + panza inferior sombreada)\nfloat ndotl = dot(N, lightDir) * 0.5 + 0.5;\nfloat topBias = N.y * 0.22;\nfloat litRaw = saturate(ndotl + topBias + (fluff - 0.5) * 0.22);\n\nfloat bandShadow = smoothstep(ShadowCut - 0.045, ShadowCut + 0.045, litRaw);\nfloat bandBright = smoothstep(ShadowCut + 0.24, ShadowCut + 0.32, litRaw);\nfloat toon = bandShadow * 0.65 + bandBright * 0.35;\n\n// De dia son blanco crema con panza celeste/lavanda; al atardecer toman tonos calidos; de noche azul tenue\nfloat3 skyEnv = max(ambCol, float3(0.035, 0.050, 0.110));\nfloat3 bellyCol = CloudTopColor * CloudShadowColor * (skyEnv * 1.25 + float3(0.04, 0.05, 0.09));\nfloat3 sunlitCol = CloudTopColor * max(lightCol, skyEnv * 0.92);\nfloat3 cloudBody = lerp(bellyCol, sunlitCol, toon);\n\n// 4. Borde plateado / dorado (Silver Lining Toon alrededor de la nube)\nfloat rimDot = 1.0 - saturate(dot(N, V));\nfloat sunBack = saturate(dot(V, -lightDir) * 0.5 + 0.5);\nfloat silverMask = smoothstep(0.54, 0.68, pow(rimDot, 2.2) * lerp(0.55, 1.15, sunBack)) * RimStrength;\nfloat3 silverRim = SunRimColor * max(lightCol, skyEnv * 0.5) * (silverMask * 0.55);\n\nOutColor = saturate(cloudBody + silverRim);"
}

