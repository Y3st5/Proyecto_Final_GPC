{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "674c012a825b48cd81cf3f77729e7233",
    "m_Group": {
        "m_Id": "a4b2e9321415463dbd1b33c10e128616"
    },
    "m_Name": "LuzVentanaDia (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -240.0,
            "y": -220.0,
            "width": 250.0,
            "height": 220.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "641498b2364f4879b1d5a1a3ccd5a785"
        },
        {
            "m_Id": "b16ee10d53b74e47a5dc7a00312f8b5a"
        },
        {
            "m_Id": "e3c2826dfe514f2cb80413a05f51dd51"
        },
        {
            "m_Id": "328de702bca6498689d300762dc22dd2"
        },
        {
            "m_Id": "0151fe993b114682ae0818d43e2da7a0"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "LuzVentanaDia",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 N = normalize(WorldNormal);\nfloat3 lightDir = normalize(float3(0.45, 0.82, 0.35));\nfloat3 lightCol = float3(1.0, 1.0, 1.0);\nfloat3 ambCol = float3(0.45, 0.52, 0.62);\nfloat shadowAtten = 1.0;\n\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED)\n    float4 clipPos = TransformWorldToHClip(WorldPos);\n    #if defined(_MAIN_LIGHT_SHADOWS_SCREEN)\n        float4 shadowCoord = ComputeScreenPos(clipPos);\n    #else\n        float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\n    #endif\n    Light mainLight = GetMainLight(shadowCoord);\n    lightDir = mainLight.direction;\n    lightCol = mainLight.color;\n    shadowAtten = mainLight.distanceAttenuation * mainLight.shadowAttenuation;\n    ambCol = SampleSH(N);\n#endif\n\n// Ventana/cristal apagado de dia: tono suave contenido sin brillo extra\nfloat ndotl = saturate(dot(N, lightDir)) * shadowAtten;\nfloat band = step(ShadowCut, ndotl);\nfloat3 dayShade = lerp(BaseColor * (ambCol * 0.65 + float3(0.01, 0.015, 0.025)), BaseColor * max(lightCol, ambCol) * 0.85, band);\nOutDay = saturate(dayShade);"
}

