{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "9a95a03120d04280b02b102193f991d8",
    "m_Group": {
        "m_Id": "fc721df864444ee8b9c16fd1396d772a"
    },
    "m_Name": "BrilloVentanaNoche (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -240.0,
            "y": 210.0,
            "width": 265.0,
            "height": 270.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "5717247bb6f54e56a7fe1c9b1c9ba10c"
        },
        {
            "m_Id": "1791e1917f3445dabf27e42a6b21bb3c"
        },
        {
            "m_Id": "afc87dc93af843ab80185ed84d022a0a"
        },
        {
            "m_Id": "19b37074502b44ed839f57aca0acc81a"
        },
        {
            "m_Id": "aec9713ae4ca48f999fa54567d862579"
        },
        {
            "m_Id": "64656a93aa31442b8e54f7fd24fe080a"
        },
        {
            "m_Id": "4a52a6a3a6c84d4c9db8bc6bbab33a51"
        },
        {
            "m_Id": "36137448b7ec4481b58012f9cc5c9f11"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BrilloVentanaNoche",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 N = normalize(WorldNormal);\nfloat3 V = normalize(WorldView);\n\n// Resplandor Toon calido de noche con nucleo mas brillante y borde suave\nfloat ndotv = saturate(dot(N, V));\nfloat coreToon = lerp(0.78, 1.0, step(0.35, ndotv));\nfloat pulse = 0.96 + 0.04 * sin(WorldPos.x * 3.7 + WorldPos.z * 2.9);\n\nfloat3 nightLit = EmissionColor * (NightGlow * coreToon * pulse);\nfloat nf = saturate(NightFactor);\n\nOutColor = lerp(DayColor, nightLit, nf);"
}

