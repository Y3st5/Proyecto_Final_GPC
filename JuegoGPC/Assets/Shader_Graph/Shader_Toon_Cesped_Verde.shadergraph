            "m_Id": "c26a2fc7b3d64938b6c943b86fbc55a6"
        },
        {
            "m_Id": "62af680aad974257ac396443a4419e05"
        },
        {
            "m_Id": "079313194286474087f0207950ea2a16"
        },
        {
            "m_Id": "3d6c88590a2644d8a91e123603a305c4"
        },
        {
            "m_Id": "43c7fb0ee6d04f948dc4e21f06b7cfdc"
        },
        {
            "m_Id": "291d9e78a15c478e8f5d7f7f937b45c5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "VientoCesped",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Viento suave en el cesped anclado en la base (UV.y = 0)\nfloat phase = (WorldPos.x * 0.55 + WorldPos.z * 0.45) + TimeVal * 1.85;\nfloat sway = sin(phase) * 0.65 + sin(phase * 2.2 + WorldPos.y * 0.9) * 0.35;\nfloat mask = saturate(UVIn.y);\nfloat3 offset = float3(sway, sway * 0.14, cos(phase * 0.90) * 0.50) * (WindStrength * mask);\nOutPos = ObjectPos + offset;"
}

