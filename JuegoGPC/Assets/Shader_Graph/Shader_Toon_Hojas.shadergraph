{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "fd01675de5084c99993340f67433b0f5",
    "m_Group": {
        "m_Id": "1f2c7bfe9b674bfcb503b1a37780aa94"
    },
    "m_Name": "ToonArbol (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 40.0,
            "y": 280.0,
            "width": 260.0,
            "height": 360.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "2bf28b89df08480b9ae26cdde28874a1"
        },
        {
            "m_Id": "c2c1fc17d7b54d64942d408b4ca14999"
        },
        {
            "m_Id": "535da1f820f34dd09e36416776694200"
        },
        {
            "m_Id": "22c448010b694dd18ea7d4d629dc796d"
        },
        {
            "m_Id": "84ef60c90a934c8d956a123f262cd342"
        },
        {
            "m_Id": "3f9737d7e3ae475599b8e59d9de5a9c7"
        },
        {
            "m_Id": "a23055c93ff24f6095b75ca008ecc778"
        },
        {
            "m_Id": "96ee703d4c9245639768a65e1b8e5c5f"
        },
        {
            "m_Id": "55b366c07af94bd499b9690fd52b401f"
        },
        {
            "m_Id": "2810b22061894642a593ab38c9aeb477"
        },
        {
            "m_Id": "d66177f6c77345c9a6cc20d2766d6bdd"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ToonArbol",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 N = normalize(WorldNormal);\nfloat3 V = normalize(WorldView);\n\n// 1. Gradiente suave de base a punta en la copa\nfloat grad = smoothstep(0.10, 0.90, saturate(UVIn.y));\nfloat3 foliageCol = BaseColor * lerp(0.82, 1.12, grad);\n\n// 2. Ruido 3D organico en espacio mundo (sin costuras UV) para borde de hojas\nfloat3 wp = WorldPos * max(0.5, LeafScale * 0.22);\nfloat3 ip = floor(wp);\nfloat3 fp = frac(wp);\nfp = fp * fp * (3.0 - 2.0 * fp);\n\nfloat n000 = frac(sin(dot(ip + float3(0.0, 0.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n100 = frac(sin(dot(ip + float3(1.0, 0.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n010 = frac(sin(dot(ip + float3(0.0, 1.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n110 = frac(sin(dot(ip + float3(1.0, 1.0, 0.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n001 = frac(sin(dot(ip + float3(0.0, 0.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n101 = frac(sin(dot(ip + float3(1.0, 0.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n011 = frac(sin(dot(ip + float3(0.0, 1.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\nfloat n111 = frac(sin(dot(ip + float3(1.0, 1.0, 1.0), float3(127.1, 311.7, 74.7))) * 43758.5453);\n\nfloat nx00 = lerp(n000, n100, fp.x);\nfloat nx10 = lerp(n010, n110, fp.x);\nfloat nx01 = lerp(n001, n101, fp.x);\nfloat nx11 = lerp(n011, n111, fp.x);\nfloat leafNoise = lerp(lerp(nx00, nx10, fp.y), lerp(nx01, nx11, fp.y), fp.z);\nfloat leafOffset = (leafNoise - 0.5) * 0.24;\n\n// 3. Luz principal (Sol de dia / Luna de noche) + Ambiente real\nfloat3 lightDir = normalize(float3(0.45, 0.82, 0.35));\nfloat3 lightCol = float3(1.0, 1.0, 1.0);\nfloat3 ambCol = float3(0.55, 0.62, 0.72);\nfloat shadowAtten = 1.0;\n\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED)\n    float4 clipPos = TransformWorldToHClip(WorldPos);\n    #if defined(_MAIN_LIGHT_SHADOWS_SCREEN)\n        float4 shadowCoord = ComputeScreenPos(clipPos);\n    #else\n        float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\n    #endif\n    Light mainLight = GetMainLight(shadowCoord);\n    lightDir = mainLight.direction;\n    lightCol = mainLight.color;\n    shadowAtten = mainLight.distanceAttenuation * mainLight.shadowAttenuation;\n    ambCol = SampleSH(N);\n#endif\n\n// 4. Bandas Toon adaptativas (sombra modulada por ambiente)\nfloat ndotl = dot(N, lightDir) * 0.5 + 0.5;\nfloat litRaw = saturate((ndotl + leafOffset) * lerp(0.30, 1.0, shadowAtten));\n\nfloat bandShadow = smoothstep(ShadowCut - 0.03, ShadowCut + 0.03, litRaw);\nfloat bandBright = smoothstep(ShadowCut + 0.26, ShadowCut + 0.32, litRaw);\nfloat toon = bandShadow * 0.62 + bandBright * 0.38;\n\nfloat3 nightFloor = float3(0.0014, 0.0023, 0.0055);\nfloat3 darkCol = foliageCol * (ambCol * (ShadowColor * 1.15 + 0.16)) + nightFloor;\nfloat3 mainDirect = foliageCol * lightCol * (toon * 0.90);\n\n// 5. Luces adicionales Toon (compatible con Forward y Forward+ en Unity 6)\nfloat3 extraLights = float3(0.0, 0.0, 0.0);\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED) && defined(_ADDITIONAL_LIGHTS)\n    InputData inputData = (InputData)0;\n    inputData.positionWS = WorldPos;\n    float4 scrPos = ComputeScreenPos(clipPos);\n    inputData.normalizedScreenSpaceUV = scrPos.xy / max(0.0001, scrPos.w);\n    uint pixelLightCount = GetAdditionalLightsCount();\n    LIGHT_LOOP_BEGIN(pixelLightCount)\n        Light addL = GetAdditionalLight(lightIndex, WorldPos);\n        float addNdotL = dot(N, addL.direction) * 0.5 + 0.5;\n        float addToon = smoothstep(0.32, 0.42, saturate(addNdotL + leafOffset * 0.5));\n        float atten = addL.distanceAttenuation * addL.shadowAttenuation;\n        extraLights += foliageCol * addL.color * (addToon * atten * 0.85);\n    LIGHT_LOOP_END\n#endif\n\nfloat3 baseToon = darkCol + mainDirect + extraLights;\n\n// 6. Borde luminoso y contraluz suave\nfloat rimDot = 1.0 - saturate(dot(N, V));\nfloat rimSun = smoothstep(0.62, 0.70, pow(rimDot, 3.0)) * bandShadow;\nfloat backGlow = smoothstep(0.50, 0.65, saturate(dot(V, -lightDir)) * rimDot);\nfloat rimMask = saturate(max(rimSun, backGlow * 0.85)) * RimStrength;\nfloat3 rimTint = HighlightColor * lightCol;\n\nOutColor = saturate(baseToon + rimTint * (rimMask * 0.35));"
}

