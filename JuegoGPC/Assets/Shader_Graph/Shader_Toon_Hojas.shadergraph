{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "61bf4c604a0d42b1839b507cdc832209",
    "m_Group": {
        "m_Id": "bdbc9037b0e545b1822baab9aaeca3a0"
    },
    "m_Name": "VientoHojas (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 40.0,
            "y": -340.0,
            "width": 260.0,
            "height": 230.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "7a182e4154914646b026a4d1752d0461"
        },
        {
            "m_Id": "c62e45b2a0e14e4b82768d9fb868d6ab"
        },
        {
            "m_Id": "dd61a129d841454bb61ef504b0b8ab6c"
        },
        {
            "m_Id": "1cabd0796f9a4b198b823dcec557b589"
        },
        {
            "m_Id": "f67d01d099e44cdeb09f7aaced0ea3ac"
        },
        {
            "m_Id": "4480749f21d24054b89738fa24bda5e8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "VientoHojas",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Viento organico anclado en la base de cada racimo (UV.y = 0)\nfloat phase = (WorldPos.x * 0.45 + WorldPos.z * 0.35) + TimeVal * 1.65;\nfloat sway = sin(phase) * 0.65 + sin(phase * 2.1 + WorldPos.y * 0.8) * 0.35;\nfloat mask = saturate(UVIn.y);\nfloat3 offset = float3(sway, sway * 0.22, cos(phase * 0.85) * 0.55) * (WindStrength * mask);\nOutPos = ObjectPos + offset;"
}

